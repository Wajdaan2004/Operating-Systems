#Do not edit the contents of this file.
CC = gcc
CFLAGS = -Werror -Wall -g -std=gnu99
TARGET = filecopy  directory_analyzer 
OBJFILES = filecopy.o directory_analyzer.o 

all: $(TARGET)
filecopy: filecopy.c
	$(CC) $(CFLAGS) -o filecopy filecopy.c
directory_analyzer: directory_analyzer.c
	$(CC) $(CFLAGS) -o directory_analyzer directory_analyzer.c
runq1: directory_analyzer.c
	./directory_analyzer
runq1-directory_analyzer: directory_analyzer.c
	sh test_F26.sh
runq2-err: filecopy.c
	./filecopy
runq2: filecopy.c
	./filecopy input.txt output.txt
runq2-strace: filecopy.c
	strace -c ./filecopy input.txt output.txt
clean:
	rm -rf $(OBJFILES) $(TARGET)  $(TARGET) *.exe  *~ *.out *.dSYM.pkgf *.dSYM